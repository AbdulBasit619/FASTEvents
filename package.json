{
  "name": "fastevents",
  "version": "1.0.0",
  "description": "University Events Website",
  "homepage": "https://github.com/AbdulBasit619/FASTEvents#readme",
  "bugs": {
    "url": "https://github.com/AbdulBasit619/FASTEvents/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbdulBasit619/FASTEvents.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "main": "index.js",
  "browserslist": [
    "last 10 versions",
    "> 0.5%",
    "not dead"
  ],
  "scripts": {
    "start": "parcel index.html",
    "build": "parcel build index.html --dist-dir ./dir --public-url ./",
    "compile:sass": "sass src/styles/sass/main.scss src/styles/style.comp.css --no-source-map",
    "prefix:css": "postcss src/styles/style.comp.css --use autoprefixer --no-map -o src/styles/style.css",
    "build:css": "run-s compile:sass prefix:css",
    "watch:sass": "sass src/styles/sass/main.scss src/styles/style.comp.css --watch --no-source-map",
    "watch:prefix": "postcss src/styles/style.comp.css --use autoprefixer --no-map -o src/styles/style.css --watch",
    "dev": "run-p start watch:sass watch:prefix",
    "release": "run-s build:css build"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "autoprefixer": "^10.6.2",
    "npm-run-all2": "^9.0.4",
    "parcel": "^2.16.4",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "sass": "^1.108.1"
  },
  "allowScripts": {
    "lmdb@2.8.5": true,
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.22": true,
    "msgpackr-extract@3.0.7": true
  }
}
